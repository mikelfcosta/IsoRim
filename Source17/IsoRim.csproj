<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.7 (Waylith): peren717/IsoRim-1.7 rendering stack (MIT). Built separately from Source/ (1.5/1.6). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRim</AssemblyName>
    <RootNamespace>IsoRim</RootNamespace>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);RW16;RW17</DefineConstants>
    <UseInstalledRimWorld Condition="'$(UseInstalledRimWorld)' == ''">false</UseInstalledRimWorld>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Portable compatibility only. Acceptance uses the approved installed build. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="[1.7.4979-alpha]" Condition="'$(UseInstalledRimWorld)' != 'true'" />
    <PackageReference Include="Lib.Harmony" Version="[3.0.0-rc.3]" ExcludeAssets="runtime" Condition="'$(UseInstalledRimWorld)' != 'true'" />
    <PackageReference Include="Lib.Harmony" Version="[3.0.0-rc.3]" ExcludeAssets="all" Condition="'$(UseInstalledRimWorld)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseInstalledRimWorld)' == 'true'">
    <Reference Include="$(RimWorldReferenceDirectory)/Assembly-CSharp.dll;$(RimWorldReferenceDirectory)/UnityStubs.dll;$(RimWorldReferenceDirectory)/RimWorld.dll;$(RimWorldReferenceDirectory)/Waylith*.dll;$(RimWorldReferenceDirectory)/Brutal*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Remove="$(RimWorldReferenceDirectory)/waylithaudio.dll" />
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
