<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The game version to build against; build.bat builds 1.5, 1.6, and 1.7 in turn. -->
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' != '1.7'">net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRim</AssemblyName>
    <RootNamespace>IsoRim</RootNamespace>
    <OutputPath>..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <IntermediateOutputPath>obj\$(RimWorldVersion)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.6'">$(DefineConstants);RW16</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the mod's own source: never the files the build generates for either version. -->
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference copies of the game's own libraries. Nothing from these is copied into the mod. -->
    <PackageReference Condition="'$(RimWorldVersion)' == '1.7'" Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
    <PackageReference Condition="'$(RimWorldVersion)' != '1.7'" Include="Krafs.Rimworld.Ref" Version="$(RimWorldVersion).*" />
    <!-- Harmony is supplied in game by the Harmony mod, so it is only referenced here, not shipped. -->
    <PackageReference Condition="'$(RimWorldVersion)' == '1.7'" Include="Lib.Harmony" Version="3.0.0-*" ExcludeAssets="runtime" />
    <PackageReference Condition="'$(RimWorldVersion)' != '1.7'" Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <!-- Lets the .NET SDK build for the game's framework without Visual Studio installed. -->
    <PackageReference Condition="'$(RimWorldVersion)' != '1.7'" Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
