# Source semantic material names, Kd and map_Kd are unchanged.
newmtl gun_dark
Kd 0.200 0.200 0.220
map_Kd IsoRim/Clay/Swatches/Metal

newmtl stuff
Kd 1.000 1.000 1.000
map_Kd IsoRim/Clay/Swatches/{stuff}

newmtl stuff_dark
Kd 0.800 0.800 0.800
map_Kd IsoRim/Clay/Swatches/{stuff}

newmtl stuff_deep
Kd 0.620 0.620 0.620
map_Kd IsoRim/Clay/Swatches/{stuff}

