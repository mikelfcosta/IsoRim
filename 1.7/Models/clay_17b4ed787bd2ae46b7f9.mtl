# Original semantic material definitions, isolated per asset to avoid batch collisions.

newmtl gun_dark
Kd 0.200 0.200 0.220
map_Kd IsoRim/Clay/Swatches/Metal

newmtl gun_wood
Kd 0.500 0.340 0.210
map_Kd IsoRim/Clay/Swatches/Wood

newmtl stuff
Kd 1.000 1.000 1.000
map_Kd IsoRim/Clay/Swatches/{stuff}
